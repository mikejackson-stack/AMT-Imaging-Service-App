# functions/.env.example — names only, no secret values.
#
# Production Ask Grok reads XAI_API_KEY from Cloud Secret Manager:
#   firebase functions:secrets:set XAI_API_KEY
#   firebase deploy --only functions
#
# Local emulator (optional): create gitignored functions/.secret.local with:
#   XAI_API_KEY=paste-key-here
# Do not copy that file into git, Pages, or this example.
#
# PIN login has no Firebase Auth token. The callable rejects unauthenticated
# callers; the app UI also refuses Ask Grok unless Google sign-in created
# fbAuth.currentUser.
