# secrets / local env — never commit keys or service-account JSON
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!functions/.env.example
functions/*.local
functions/.secret.local

# deps and firebase logs
functions/node_modules/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
.firebase/

# local serve staging if someone uses a persistent dir
_devsite/

