Magnet,DVw-SiFe,HM
Rings,45
Slots,36
Geometry,100,-(100),,cm
Thickness,56
PasvCal,DVw_PassiveSIFE.cal
Quantum,1.0

Coils,18
Current,0.0
ActiveCal,lcc.cal

InputMapTempl,W_CoronaCamera50dsv
UnifiedMapTempl,DVw-45fov-unified
Tolerance,23.0:8.5:3.0:0.6:0.1

# Specify the field map template for checking spec
SpecTemplate,DVw-45fov-unified
# Specify the max PPM values to achieve specification
# 2nd spec                   Tony's numbers
# 15 P-P PPM for overall map  N/A
# 12 P-P PPM for 50x40 cm     25.0
#  2 P-P PPM for 45x36 cm     10.0 
#  0 P-P PPM for 42x32 cm      4.0
#  0 P-P PPM for 30x24 cm      1.0
#  0 P-P PPM for 20x16 cm      0.5
#
SpecLimits,25.0,10.0,4.0,1.0,0.5

ReportVol,24,24,0,0.25,0.24,0.225,0.2,0.175,0.15,0.1,0.05
