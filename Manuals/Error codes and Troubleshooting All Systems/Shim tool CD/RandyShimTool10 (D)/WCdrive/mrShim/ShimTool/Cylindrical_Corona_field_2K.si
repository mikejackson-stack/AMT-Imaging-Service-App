########################################################
########################################################
# NO '=' as a field seperator, use ','                 # 
########################################################
#    Used with corona Shimtool Version 2.5B            #
#    Modified 05_JUL-2006 to add "WB" series magnet    #
#    and run with Version 2.5C shimtool                #
#    Name changed to "Cylindrical_Corona_field_2K.si"  #
#    Added XRMB/DVMR shimming                          #
#                                                      #
# modified for MR450 / MR450w field use                #
#    Added R/RB series magnet with XRMB for MR450      #
#    and run with ShimTool 2.5D                        #
#                                                      #
#               FIELD USE ONLY CORONA                  #
########################################################
# Known Commands Are:
#       magnet,name,series - begins a magnet definition
#       Visible,True | False - determine whether subtype is visible in the menu
#       Rings,# - number of passive shim rings (number of locations in Z)
#       Slots,# - number of passive shim slots (Number of locations in phi)
#       Geometry,Radius,-Z centroid,[+Z centroid],[unit] - passive shim geometry
#       Phi,angle - angular offset of first shim center from 0
#       Thickness,number - default maximum shim thickness
#       PasvCal,filename - name of the default passive calibration
#       Quantum,number - minimum shim thickness for rounding
#       Precision,number - number of decimals in printout (default 1)
#       Coils,number - number of shim coils
#       Current,number - maximum shim current
#       ActiveCal,filename - name of the default active calibration
#       InputMapTempl,mapname - map template for input field maps
#       UnifiedMapTempl,mapname - map template on which to perform shim
#       Tolerance,filename - default unified target file
#       SpecTemplate,mapname - map template for checking spec (subsample with interpolation)
#       SpecLimits[,Overall PPM],value per volume,... - if negative use as +/- value
#       Unit,string - sets the units name printed in the output (default is mil)
#       ReportVolumes,dsv1,dsv2,dsv3,.....
###################################################################################


#####################################################################################
Magnet,Corona,W
Rings,25
Slots,36

# This is the radius, then Z- of the last shim centroid
Geometry,45.6325,-30,,cm
Thickness,6
PasvCal,C:\MrShim\shimtool\W_CoronaP.cal
Quantum,1

Coils,14
Current,20.0
ActiveCal,C:\MrShim\shimtool\W_CoronaSC.cal

#Force,50

InputMapTempl,W_CoronaCamera50dsv
UnifiedMapTempl,G3UnifiedTarget
Tolerance,9.5,6.5,2.0,0.3,0.05

Unit, shims

# Specify the field map template for checking spec
SpecTemplate,Corona-SpecVols
# Specify the max PPM values to achieve specification
# Corona Spec Volumes Field Map
# 24x24 48x45 cm         12 ppm
# 24x24 40 cm            4.0 ppm
# 24x24 30 cm            1.2 ppm
# 12x12 20 cm            0.3 ppm
SpecLimits,30,12,4.0,1.2,0.3

# Specifies the volumes to report PPM and RMS values on in the ATR file
# first two numbers are # of circles and # of arcs, # of on axis (0 or 2 only)
# then DSV radii
# Alternate format is ReportVol,map-template-name
ReportVol,24,24,0,0.25,0.24,0.225,0.2,0.15,0.1,0.05
# The spec values for each volume
ReportVRMS,3.00,2.0,1.00,0.5,0.25,0.05,0.02



