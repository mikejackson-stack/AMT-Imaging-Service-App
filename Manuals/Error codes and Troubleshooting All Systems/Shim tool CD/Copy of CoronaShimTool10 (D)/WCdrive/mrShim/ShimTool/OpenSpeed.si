d=0.970,inch
phi=-360/25/4,degrees
positions=25
hole=2.0,mm

pattern,hole
d=1.126,inch
phi=-360/25*7+90,degrees
positions=25
hole=2.0,mm

pattern,hole
d=1.321,inch
phi=0,degrees
positions=40
hole=2.0,mm

pellet,solid
mass=0.0832,g,0.0832*0.02187
color=black
uses=hole

# Entry for Robot Compatibility Only
pellet,95%
mass=0.0832*0.946,g
thres=40
min=1.0
color=green
uses=hole

pellet=red
color=red
mass=0.0832*0.0471,g,0.0832*0.0052136
limit=21
thres=40
uses=hole

finish,disc,FactoryBigInner

