# Second Section, plate defines topology of the two shim plates
# Field and Factory
###########################
###########################


# ShimPlate definition, made up of the shim discs
# factory plate is i = 1, 13 rings, bolt holes, larger z
# field plate is i = 0, 12 rings, no hole , smaller z

plate,Factory

Robot=true

#Set the Plate Height
height=30.6,cm

#set the plate diameter
diameter=39.31,inches

# Auto Tolerancer Release limit
# Input Map PPM		Maximum Target PPM
AutoTolLimit,3
16	11.4
20	10.8
30	10.0

############

ring,1
color=grey
diam=1.75,inches
depth=1.5664,cm
# Stack means each additional disc adds 8.3% to cal
stack=0.083058232

disc,FactorySmall
positions=4

############

ring,2
color=red
diam=3.55,inches
depth=1.5664,cm
stack=0.089814568
#stack=0.083058232


disc,FactorySmall
positions=12

############

ring,3
color=green
diam=5.35,inches
depth=1.5553,cm
stack=0.104891611
#stack=0.083058232

disc,FactorySmall
positions=18

########

ring,4
color=yellow2
diam=7.15,inches
depth=1.5553,cm
stack=0.155522763
#stack=0.083058232

disc,FactorySmall
positions=24

########

ring,5
color=purple
diam=8.95,inches
depth=1.5608,cm
stack=0.079905448
#stack=0.083058232


disc,FactorySmall
positions=30

########

ring,6
color=blue
diam=10.75,inches
depth=1.5608,cm
stack=0.077211671
#stack=0.083058232

disc,FactorySmall
positions=36

########

ring,7
color=grey
diam=13.558,inches
depth=1.5008,cm
stack=0.085049448
#stack=0.083058232

do,j,-12.5,12.5,,2
disc,FactoryBigInner
positions=2
phi=90+j,degrees
rotation=90,degrees
enddo,j

do,j,0,1
disc,FactoryBigInner
positions=8
phi=180*j-126/2,degrees
spacing=126/7,degrees
rotation=90,degrees
enddo

#####
ring,8
color=red
diam=17.702,inches
depth=2.1496,cm
stack=0.199600707

do,j,0,1
disc,FactoryBigInner
positions=13
phi=j*180+360/30*1.5,degrees
spacing=360/30,degrees
rotation=90,degrees
enddo

do,j,-1,1,,2
disc,FactoryBigInner
positions=2
phi=j*360/30/2,degrees
rotation=90+j*28.4,degrees
enddo

#####

ring,9
color=green
diam=21.472,inches
depth=0.7648,cm

do,j,1.5,3.5,,3
disc,FactoryBigInner
positions=6
phi=j*360/30,degrees
rotation=90,degrees
enddo

do,j,-1,1,,2
disc,FactoryBigInner
positions=6
phi=j*360/30/2,degrees
rotation=90+j*25.9,degrees
enddo

#####

ring,10
color=yellow2
diam=25.477,inches
depth=2.5031,cm
limit=2
stack=0.059635085

disc,FactoryBig
rotation=90,degrees
positions=40

#####

ring,11
color=purple
diam=29.365,inches
depth=4.2457,cm
limit=5
stack=0.04

disc,FactoryBig
rotation=90,degrees
positions=40

#####

ring,12
color=blue
diam=33.349,inches
depth=4.8415,cm
limit=6
stack=0.03

disc,FactoryBig
rotation=90,degrees
positions=50

#####

# this ring only exists on the factory plate

ring,13
color=beige
diam=37.268,inches
depth=3.3619,cm
stack=0.02

disc,FactoryBig
rotation=90,degrees
positions=50

finish,plate

# ShimPlate definition, made up of the shim discs
# factory plate is i = 1, 13 rings, bolt holes, larger z
# field plate is i = 0, 12 rings, no hole , smaller z


###################################################
###################################################
###################################################

plate,Field

Robot=true

#set the plate height
height=27.2,cm

#set the plate diameter
diameter=36.92,inches

# Maps are initially shimmed on smoothed harmonics
smooth,0.0
:16
:8 *

# MUST LEAVE A BLANK LINE AFTER "8 * " TO SIGNIFY END OF HARMONICS LIST

# Automagically disable discs that are more than 80% full
AutoDisable,20.0,0.80

# Auto Tolerancer Release limit
# Input Map PPM		Maximum Target PPM
AutoTolLimit,3
16	11.4
20	10.8
30	10.0

# Override the default shim volumes
Unified=OpenSpeed-Field-Unified,OSSpecVols.tol,9,2.5,1.5,0.25

############

ring,1
color=grey
diam=1.75,inches
depth=0.5,cm

disc,FieldSmall
positions=4

############

