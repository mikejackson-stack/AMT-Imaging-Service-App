positions=36

########

ring,7
color=grey
diam=13.558,inches
depth=0.5,cm

disc,FieldBigInner
positions=20
rotation=90,degrees

#####
ring,8
color=red
diam=17.702,inches
depth=0.5,cm

disc,FieldBigInner
positions=30
rotation=90,degrees

#####

ring,9
