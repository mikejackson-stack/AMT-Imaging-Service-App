# Original: 9:07 AM 4/17/99
# Revision 1: 7:45 AM 8/11/99
# Revision 2: Release 1.0 format 11:30 AM 10/17/99
# Revision 3: Release 1.0 Format 10:22 AM 10/25/99
# Revision 4: Release 1.0 Format 10:52 AM 12/06/99
# BCA - Added internal and external disc names
# Revision 5: Release 1.1 Format 11:54 AM 2/8/00
# BCA - Added unified shimming volumes and split outer rings
# BCA - Added Argus3Factory
# Revision 5: Release 1.1 Format 10:39 AM 4/10/2000
# BCA - Modified for new poleface, moved old poleface to OldFactory
# Revision 6: Release 1.2 Format 
# Revision 7: Release 1.3x Format 9:09 PM 8/13/2000
# BCA - Mass of Red and Grey updated 
# BCA - Auto Tolerace Release limits added
# Revision 7a: Release 2.x Format 9:09 PM 8/13/2000
# Since no change was made to the plate or discs, don't up the rev number
# BCA - Changed Unified Map type to template name, allow plate to override
# BCA - Added default tol file and manual targets
# Revision 7a: Release 2.x Format 
# BCA - Added default tol file and manual targets
Revision=7a

# Describe the volumes used for unified
# Map Template name, default target file, default volume targets
Unified=OpenSpeed-Unified,OpenSpeed.tol,9,1.5,0.25

# Specifies the volumes to report PPM and RMS values on in the ATR file
# first two numbers are # of circles and # of arcs
# then DSV radii
# Alternate format is ReportVol,map-template-name
ReportVol,24,24,0,0.2,0.175,0.15,0.1,0.05

Series=T
# Specify the field map template for checking spec
SpecTemplate=OpenSpeed-SpecVols
# Specify the max PPM values to achieve specification
SpecLimits=14,4,2,0.5
# Specifiy the harmonics to zero and their maximum value for zeroing
SpecZero=3,1;*,2


# FINAL FORMAT is Rev 7 -- DO NOT ALTER THIS FILE

# Data Taken in MKE 8/12/2000 and FLO 8/13/2000
# Solid mass is normalized (via calibration file to 0.0832)
# Solid:Mass=0.0832
# Red:Ratio=0.0471
# Red:Ratio:StdDev=0.0052136
# Grey:Ratio=0.0237
# Grey:Ratio:StdDev=0.0052960

# New MR shim plate discription file
# First Section, disc defines generic topology of the two shim disc types
# Big, Type B and Small Type A

###################
###################

# FactorySmall is the factory name for the small discs

disc,FactorySmall,Small
d=0.69,0.77,inch
slot=2*0.132,0.092,inches
height=0.5,cm
# PPM above which partials are disabled
partial=800

# Inner ring hole pattern
pattern,hole
diam=0.378,inch
phi=0,degrees
positions=12
hole=2.0,mm

# Outer Ring
pattern,hole
diam=0.568,inch
phi=-(360/15)*4+90,degrees
positions=15
hole=2.0,mm

pellet,solid
mass=0.0832,g,0.0832*0.02187
color=black
uses=hole

pellet,95%
mass=0.0832*0.9574,g,0.0832*0.02187
thres=50
min=1.00
color=green
uses=hole

pellet=red
color=red
mass=0.0832*0.0471,g,0.0832*0.0052136
thres=50
uses=hole

finish,disc,FactorySmall

###################
###################

# FieldSmall is the field name for the small discs

disc,FieldSmall,Small
d=0.69,0.77,inch
slot=2*0.132,0.092,inches
height=0.5,cm
nonsym=true

# Inner ring hole pattern
pattern,hole
diam=0.378,inch
phi=0,degrees
positions=12
hole=2.0,mm

# Outer Ring
pattern,hole
diam=0.568,inch
phi=-(360/15)*4+90,degrees
positions=15
hole=2.0,mm

pellet,solid
mass=0.0832,g,0.0832*0.02187
color=black
uses=hole

pellet=red
color=red
mass=0.0832*0.0471,g,0.0832*0.0052136
thres=90
limit=21
uses=hole

pellet,green
color=green
mass=0.0832*0.0237,g,0.0832*0.005296
limit=1
thres=1
uses=hole

finish,disc,Small

