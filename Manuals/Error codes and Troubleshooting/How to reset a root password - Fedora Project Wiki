@charset "utf-8";

.wikicleanup { background-image: url("/w/uploads/7/72/Wiki-cleanup-background.png"); background-repeat: repeat; }

#toolbar, #wpTextbox1 { clear: none; }

#otherlangs { margin: 0.5em 0px; padding: 5px; border: 1px solid rgb(204, 204, 204); background: rgb(250, 250, 250); font-size: 0.9em; }

#otherlangs span.languagelink { margin: 0px 2px; padding-left: 5px; border-left: 1px solid gray; }

#otherlangs span.firstlang { border: none; padding-left: 1px; }

#otherlangs .new a { color: rgb(186, 0, 0) !important; }

#otherlangs .editlink { float: right; }

.collapseButton { float: right; font-weight: normal; text-align: right; width: auto; }

.padcollapsebutton .collapseButton { margin-left: 1em; }

.sopablackout a { color: white !important; }

@media print {
  #head, #sidebar { display: none; }
}
